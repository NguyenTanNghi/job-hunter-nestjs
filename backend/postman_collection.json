							"raw": "{{base_url}}/users/:id",
							"host": ["{{base_url}}"],
							"path": ["users", ":id"],
							"variable": [
								{
									"key": "id",
									"value": "647b69a9d1c6875fa3feac20",
									"description": "ID người dùng cần lấy thông tin"
								}
							]
						},
						"description": "Lấy thông tin người dùng theo ID (không trả về password, không bắt buộc JWT)."
					},
					"response": []
				},
				{
					"name": "2.4 Update User (JWT Required)",
					"request": {
						"auth": {
							"type": "bearer",
							"bearer": [
								{
									"key": "token",
									"value": "{{access_token}}",
									"type": "string"
								}
							]
						},
						"method": "PATCH",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"_id\": \"647b69a9d1c6875fa3feac20\",\n  \"name\": \"hỏi dân it\",\n  \"email\": \"abc@gmail.com\",\n  \"age\": 25,\n  \"gender\": \"male\",\n  \"address\": \"vietnam\",\n  \"role\": \"ADMIN\",\n  \"company\": {\n    \"_id\": \"647b51974d59e754db118e95\",\n    \"name\": \"eric company\"\n  }\n}"
						},
						"url": {
							"raw": "{{base_url}}/users",
							"host": ["{{base_url}}"],
							"path": ["users"]
						},
						"description": "Cập nhật thông tin người dùng (Tự động gán updatedBy)."
					},
					"response": []
				},
				{
					"name": "2.5 Delete User (JWT Required)",
					"request": {
						"auth": {
							"type": "bearer",
							"bearer": [
								{
									"key": "token",
									"value": "{{access_token}}",
									"type": "string"
								}
							]
						},
						"method": "DELETE",
						"header": [],
						"url": {
							"raw": "{{base_url}}/users/:id",
							"host": ["{{base_url}}"],
							"path": ["users", ":id"],
							"variable": [
								{
									"key": "id",
									"value": "647b69a9d1c6875fa3feac20",
									"description": "ID người dùng cần xóa"
								}
							]
						},
						"description": "Xóa người dùng bằng soft-delete (Tự động gán deletedBy)."
					},
					"response": []
				}
			]
		},
